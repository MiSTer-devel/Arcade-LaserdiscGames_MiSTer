<misterromdescription>
    <name>Dragon's Lair (Enhanced)</name>
    <region>US</region>
    <homebrew>no</homebrew>
    <bootleg>no</bootleg>
    <version>v1.1</version>
    <alternative></alternative>
    <platform></platform>
    <series>Dragon's Lair</series>
    <year>1983</year>
    <manufacturer>Cinematronics</manufacturer>
    <category>LaserDisc</category>

    <setname same_dir="1">dlair</setname>
    <parent>dlair</parent>
    <mameversion>0270</mameversion>
    <rbf>LaserdiscGames</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>horizontal</rotation>
    <flip>no</flip>

    <players>1</players>
    <joystick>4-way</joystick>
    <special_controls></special_controls>
    <num_buttons>1</num_buttons>
    <buttons names="Sword,Not Used,Not Used,Not Used,Coin,Start 1P,Start 2P,Pause" default="A,B,X,Y,Select,Start,R,L"/>

    <switches default="22,D8">
        <dip bits="15" name="Difficulty" ids="Ramps Up,Always Easy"/>
        <dip bits="2"  name="- Ramp Style" ids="Gradual,Instant (Hard)"/>
        <dip bits="12" name="- Ramp After" ids="5 In A row,9 In A Row"/>
        <dip bits="0"  name="Coinage" ids="2 Coins/1 Credit,3 Coins/1 Credit"/>
        <dip bits="6"  name="Pay As You Go" ids="Off,On"/>
        <dip bits="13,14" name="- Pay As You Go Option" ids="PAYG1,PAYG2,PAYG3,PAYG4"/>
        <dip bits="4"  name="Free Play" ids="Off,On"/>
        <dip bits="5"  name="Lives" ids="3,5"/>
        <dip bits="10" name="Unlimited Dirks" ids="Off,On"/>
        <dip bits="9"  name="Demo Sounds" ids="On,Off"/>
        <dip bits="8"  name="- Demo Sound Reps" ids="Every 8,All"/>
        <dip bits="3"  name="Engineering Mode" ids="Off,On"/>
        <dip bits="7"  name="Service Mode" ids="Off,On"/>
        <dip bits="11" name="LD Player" ids="LD-PR7820,LD-V1000"/>
    </switches>

    <!-- Index 0: Main Z80 program ROMs. Rev F2 = 4x 8KB @ 0x0000-0x7FFF (region is 0xA000; 0x8000-0x9FFF unused on F2). -->
    <rom index="0" md5="none" zip="dle11.zip">
        <part crc="3d1f44f7" name="dle11u1l.bin"/>
        <part crc="875d4329" name="dle11u2l.bin"/>
        <part crc="185e7c3d" name="dle11u3l.bin"/>
        <part crc="90fa4db2" name="dle11u4l.bin"/>
    </rom>

    <remark>Dragon's Lair Enhanced (Cinematronics)</remark>
    <mratimestamp>20260703000000</mratimestamp>
</misterromdescription>
