<misterromdescription>
    <name>Dragon's Lair</name>
    <region>US</region>
    <homebrew>no</homebrew>
    <bootleg>no</bootleg>
    <version>Rev F2</version>
    <alternative></alternative>
    <platform></platform>
    <series>Dragon's Lair</series>
    <year>1983</year>
    <manufacturer>Cinematronics</manufacturer>
    <category>LaserDisc</category>

    <setname>dlair</setname>
    <parent>dlair</parent>
    <mameversion>0270</mameversion>
    <rbf>DragonsLair</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>horizontal</rotation>
    <flip>no</flip>

    <players>1</players>
    <joystick>4-way</joystick>
    <special_controls></special_controls>
    <num_buttons>1</num_buttons>
    <buttons names="Sword,Not Used,Not Used,Not Used,Coin,Start 1P,Start 2P,Pause" default="A,B,X,Y,Select,Start,R,L"/>

    <!-- DIPs from MAME dlair.cpp INPUT_PORTS_START(dlair). Two 8-bit banks read via the AY-3-8910:
           DSW1 (op-sw "A") = AY port A  -> core dsw[7:0]   = MRA bits 0-7
           DSW2 (op-sw "B") = AY port B  -> core dsw[15:8]  = MRA bits 8-15
         bits="lo,hi" is an INCLUSIVE RANGE (not a list). MAME defaults: DSW1=0x20, DSW2=0x79.
         Difficulty (DSW2 0x90 split w/ DSW1 0x04 condition) omitted for now — verify before adding. -->
    <switches default="20,79">
        <!-- DSW1 / bank A (bits 0-7) -->
        <dip bits="0"  name="Coinage" ids="2 Coins/1 Credit,3 Coins/1 Credit"/>
        <dip bits="3"  name="Engineering Mode" ids="Off,On"/>
        <dip bits="4"  name="2 Credits/Free Play" ids="Off,On"/>
        <dip bits="5"  name="Lives" ids="3,5"/>
        <dip bits="6"  name="Pay as you go" ids="Off,On"/>
        <dip bits="7"  name="Service Mode" ids="Off,On"/>
        <!-- DSW2 / bank B (bits 8-15) -->
        <dip bits="8"  name="Sound Every 8 Attracts" ids="Off,On"/>
        <dip bits="9"  name="Demo Sounds" ids="On,Off"/>
        <dip bits="10" name="Unlimited Dirks" ids="Off,On"/>
        <dip bits="11" name="Joystick Feedback Sound" ids="Off,On"/>
    </switches>

    <!-- Index 0: Main Z80 program ROMs. Rev F2 = 4x 8KB @ 0x0000-0x7FFF (region is 0xA000; 0x8000-0x9FFF unused on F2). -->
    <rom index="0" md5="none" zip="dlair.zip|dlair.zip">
        <part crc="f5ea3b9d" name="dl_f2_u1.bin"/>
        <part crc="dcc1dff2" name="dl_f2_u2.bin"/>
        <part crc="ab514e5b" name="dl_f2_u3.bin"/>
        <part crc="f5ec23d2" name="dl_f2_u4.bin"/>
    </rom>

    <remark>Dragon's Lair (Cinematronics). Index 0 = Z80 game logic only; LaserDisc video is handled inside the core (WIP).</remark>
    <mratimestamp>20260703000000</mratimestamp>
</misterromdescription>
